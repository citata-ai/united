---
import AuditCta from "../../components/AuditCta.astro";
import Base from "../../layouts/Base.astro";
import { tools, toolsPublished } from "../../data/tools.ts";

const title = "Free Tools for Landlords and Property Managers — Citata.ai";
const description =
  "Free calculators for landlords and property managers: property management fee calculator and Section 8 rent calculator (tenant share, HAP, 40% check).";

const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Free tools for landlords and property managers",
  itemListElement: tools.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.name,
    url: `https://citata.ai${t.href}`,
  })),
};
---

<Base title={title} description={description} modified={toolsPublished}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(list)} />
  <main class="wrap">
    <section class="mt-8 rounded-lg bg-sky/20 p-6 sm:p-12">
      <p class="meta"><a href="/guides" class="text-minium underline underline-offset-2">Guides</a> › <span class="text-minium">Free tools</span> · for landlords and property managers</p>
      <h1 class="mt-4 max-w-3xl text-[38px] leading-[1.04] sm:text-[52px]">Free Rental Calculators</h1>
      <p class="mt-5 max-w-[66ch] text-[19px] text-muted">
        Two calculators for questions that need a number. Each page shows the answer and a worked
        example first, then the tool. Every typical number names its source. Your numbers stay in your
        browser.
      </p>
      <p class="meta mt-5">Published <time datetime={toolsPublished}>{toolsPublished}</time></p>
    </section>
    <ul class="grid gap-6 py-12 md:grid-cols-2">
      {
        tools.map((t) => (
          <li>
            <a href={t.href} class="group block h-full rounded-md border border-rule bg-page p-6 hover:border-minium">
              <p class="meta">
                <span class={`rounded-full px-2 py-0.5 text-ink ${t.chip}`}>Tool</span> · free
              </p>
              <h2 class="mt-3 text-[26px] leading-tight group-hover:text-minium">{t.name}</h2>
              <p class="mt-2 text-[16px] text-muted">{t.dek}</p>
              <p class="mt-4 text-[15px] text-minium underline underline-offset-2">Open the calculator</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="max-w-[66ch] text-[15px] text-muted">
      More reading: <a class="link" href="/guides">guides for property management companies</a>.
    </p>
    <AuditCta />
  </main>
</Base>
