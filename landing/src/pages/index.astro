---
import Base from "../layouts/Base.astro";
import PlatformRibbon from "../components/PlatformRibbon.astro";
import Mechanism from "../components/Mechanism.astro";
import Stamps from "../components/Stamps.astro";
import PromptTester from "../components/PromptTester.astro";
import { auditHref, offers } from "../data/site.ts";
import { faq } from "../data/faq.ts";

// Copy sources: business/strategy.md (§1 one line, §2 process, §3 verticals, §5 facts),
// business/offers.toml (price ladder), business/case-studies/fridman-properties.md (demand trend,
// baseline). Every number names its source. Niche: US property management companies only.
const title = "Citata.ai — GEO for property management companies";
const description =
  "Landlords now ask ChatGPT and Gemini which property manager to hire. Citata.ai gets your property management company named and linked in that answer.";

const facts = [
  {
    n: "−46%",
    text: "Google searches for property management, Chicago area, year over year",
    src: "Keyword Planner, our data",
    href: "/case-studies/fridman-properties",
    bg: "bg-coral",
  },
  {
    n: "5",
    text: "managers named in a typical AI answer. Not on the list? The landlord never hears your name",
    src: "our baseline, 132 answers",
    href: "/case-studies/fridman-properties",
    bg: "bg-sun",
  },
  {
    n: "12.1%",
    text: "of one site's signups came from AI, which sent only 0.5% of its visits",
    src: "Ahrefs",
    href: "https://ahrefs.com/blog/ai-search-traffic-conversions-ahrefs/",
    bg: "bg-sky",
  },
];

const stages = [
  { n: "01", name: "Indexed", text: "AI crawlers can read every landlord page.", bg: "bg-cobalt/12", chip: "bg-cobalt text-page" },
  { n: "02", name: "Found", text: "Your pages answer what landlords ask.", bg: "bg-mint/35", chip: "bg-mint" },
  { n: "03", name: "Mentioned", text: "AI names you, with a link, in your city.", bg: "bg-coral/15", chip: "bg-coral" },
];

const steps = [
  { head: "Send one sentence", text: "Your goal, by email." },
  { head: "We take a baseline", text: "4 AI engines, your landlords’ questions." },
  { head: "One change a day", text: "A person checks each one." },
  { head: "Monday report", text: "Who named you, and what changed." },
];

const caseNumbers = [
  { n: "90", text: "pages moved, every URL kept" },
  { n: "144", text: "AI answers in the baseline" },
  { n: "8 / 132", text: "landlord answers named them" },
];

const fit = {
  yes: [
    "US property management companies with 50 to 500 doors",
    "Single-family homes and small multifamily",
    "You sell to landlords and want more landlord leads",
    "Section 8 and affordable housing managers",
    "PMS and proptech software that sells to property managers",
  ],
  no: [
    "Large apartment communities that need renter leads: listing sites win those answers (72% of AI citations, Peek)",
    "HOA and condo association management",
    "Any business that does not serve property management",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO and AEO for property management companies",
  serviceType: "Generative engine optimization",
  provider: { "@id": "https://citata.ai/#org" },
  areaServed: { "@type": "Country", name: "United States" },
  audience: { "@type": "BusinessAudience", name: "Property management companies with 50 to 500 doors" },
  description:
    "Done-for-you GEO: weekly tracking of landlord questions on ChatGPT, Gemini, Claude and Perplexity, one human-checked change a day, and a Monday report.",
  offers: [
    { "@type": "Offer", name: "Free AI visibility audit", price: 0, priceCurrency: "USD" },
    { "@type": "Offer", name: "Starter", price: 750, priceCurrency: "USD" },
    { "@type": "Offer", name: "Growth", price: 2000, priceCurrency: "USD" },
  ],
};

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "GEO for property management companies",
  description,
  author: { "@type": "Person", "@id": "https://citata.ai/about#founder", name: "Taras Kornichuk", jobTitle: "Founder", url: "https://citata.ai/about" },
  publisher: { "@id": "https://citata.ai/#org" },
  datePublished: "2026-10-18",
  dateModified: "2026-10-18",
  mainEntityOfPage: "https://citata.ai/",
  about: ["Generative engine optimization", "Property management"],
};

const usd = (n: number) => (n === 0 ? "$0" : `$${n.toLocaleString("en-US")}`);
---

<Base title={title} description={description} image="/og/hero-v9.jpg" modified="2026-10-18">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(article)} />
  </Fragment>
  <main>
  <!-- Hero: three-ink stamp engraving (brand/IMAGES.md). The white sky blends into the page (multiply).
       ≥1280px the text sits in the empty sky; below that, text first and the picture after it. -->
  <section class="relative">
    <div class="wrap relative z-10 flex flex-col items-center pt-14 text-center xl:absolute xl:inset-x-0 xl:top-0 xl:pt-[3.4vw]">
      <p class="meta"><span class="text-minium">GEO + AEO</span> · for property management companies</p>
      <h1 class="mt-5 max-w-3xl text-[44px] leading-[1.02] sm:text-[56px] lg:text-[64px]">
        Get named when landlords ask AI for a property manager
      </h1>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a class="btn-primary !px-5 !py-3 !text-[15px]" href={auditHref}>Get a free AI visibility audit</a>
        <a class="btn-secondary !border-ink !px-5 !py-3 !text-[15px] !text-ink hover:!bg-ink hover:!text-page" href="#engine">See how it works</a>
      </div>
    </div>
    <img
      src="/img/hero-v9-1280.webp"
      srcset="/img/hero-v9-640.webp 640w, /img/hero-v9-960.webp 960w, /img/hero-v9-1280.webp 1280w, /img/hero-v9-1920.webp 1920w, /img/hero-v9-2560.webp 2560w, /img/hero-v9-3840.webp 3840w"
      sizes="100vw"
      alt="An engraved ancient town being built, with pop accents: a temple frieze painted in cobalt, coral and yellow, striped awnings, mint doors, flower pots and pennants on the crane; tiled houses and scaffolding on the left, a large temple with cypress trees on the right, and a man in an orange toga with a big key walking toward us from a temple with a glowing door."
      width="3840"
      height="2145"
      fetchpriority="high"
      class="-mt-[8vw] block h-auto w-full mix-blend-multiply xl:mt-0"
    />
  </section>

  <PlatformRibbon />

  <div class="wrap">
    <Stamps />
  </div>

  <div class="wrap">
    <!-- 01 The problem -->
    <section aria-labelledby="why-h" class="py-16">
      <p class="chapter" style="--chip:var(--color-coral)"><b>01</b>The problem</p>
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
        <div>
          <h2 id="why-h" class="text-[36px] leading-[1.05] sm:text-[44px]">Landlords stopped searching. They ask AI.</h2>
          <figure class="img-frame mt-8">
            <img src="/img/problem-v1-720.webp" srcset="/img/problem-v1-640.webp 640w, /img/problem-v1-960.webp 960w, /img/problem-v1-1280.webp 1280w, /img/problem-v1-1920.webp 1920w" sizes="(min-width: 1024px) 45vw, calc(100vw - 40px)" alt="A pop engraving under a cyan sky: a landlord in an orange toga waits on the steps of a quiet villa by an empty letterbox, while far away people line up at a small oracle temple." width="1280" height="714" loading="lazy" />
          </figure>
        </div>
        <ul class="grid gap-4">
          {
            facts.map((f) => (
              <li class={`grid grid-cols-[auto_1fr] items-center gap-6 rounded-md p-6 sm:p-7 ${f.bg}`}>
                <p class="min-w-[3.2ch] text-[52px] leading-none font-semibold sm:text-[60px]">{f.n}</p>
                <div>
                  <p class="text-[17px] leading-snug">{f.text}</p>
                  <a class="meta mt-2 inline-block text-ink/75 underline underline-offset-2 hover:text-ink" href={f.href}>{f.src}</a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- 02 How it works: its own tinted band -->
  <section id="how" aria-labelledby="how-h" class="border-y border-rule bg-page py-16">
    <div class="wrap">
      <p class="chapter" id="engine" style="--chip:var(--color-sky)"><b>02</b>How it works</p>
      <h2 id="how-h" class="text-[36px] leading-[1.05] sm:text-[44px]">Indexed → Found → Mentioned</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {
          stages.map((s) => (
            <li class={`rounded-md p-6 ${s.bg}`}>
              <span class={`meta inline-block rounded-full px-2.5 py-1 ${s.chip}`}>{s.n}</span>
              <h3 class="mt-3 text-[26px]">{s.name}</h3>
              <p class="mt-1 text-[16px] text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-10">
        <Mechanism />
      </div>

      <div class="mt-14 grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h3 class="text-[28px] leading-tight">Your first month</h3>
          <ol class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              steps.map((s, i) => (
                <li class="rounded-md border border-rule bg-parchment p-5">
                  <span class="meta text-minium">Step {i + 1}</span>
                  <p class="mt-1 text-[18px] font-medium">{s.head}</p>
                  <p class="text-[15px] text-muted">{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <figure class="img-frame">
          <img src="/img/monday-report-v3-720.webp" srcset="/img/monday-report-v3-640.webp 640w, /img/monday-report-v3-720.webp 720w, /img/monday-report-v3-960.webp 960w, /img/monday-report-v3-1280.webp 1280w, /img/monday-report-v3-1920.webp 1920w" sizes="(min-width: 1024px) 50vw, calc(100vw - 40px)" alt="A pop engraving of a Roman market under a coral sky: a herald in an orange toga holds up a scroll with a rising blue bar chart, a bronze bell hangs beside him, and townspeople look up." width="1280" height="714" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <div class="wrap">
    <!-- 03 Try it -->
    <section id="ask" aria-labelledby="try" class="grid gap-10 py-16 md:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="chapter" style="--chip:var(--color-mint)"><b>03</b>Try it now</p>
        <h2 id="try" class="text-[36px] leading-[1.05] sm:text-[44px]">Ask AI what your landlords ask</h2>
        <p class="mt-4 max-w-[44ch] text-muted">Type your city and open a question. Are you in the answer?</p>
        <a href="/property-management" class="link mt-5 inline-block">All landlord questions we track →</a>
      </div>
      <PromptTester />
    </section>

    <!-- 04 Case study -->
    <section aria-labelledby="proof" class="rounded-lg bg-sun/25 p-6 sm:p-10">
      <p class="chapter" style="--chip:var(--color-sun)"><b>04</b>Case study · in progress</p>
      <div class="grid items-center gap-10 md:grid-cols-[1.1fr_1fr]">
        <a href="/case-studies/fridman-properties" class="img-frame img-zoom block overflow-hidden">
          <img src="/img/fridman-case-v3-720.webp" srcset="/img/fridman-case-v3-640.webp 640w, /img/fridman-case-v3-720.webp 720w, /img/fridman-case-v3-960.webp 960w, /img/fridman-case-v3-1280.webp 1280w, /img/fridman-case-v3-1920.webp 1920w" sizes="(min-width: 768px) 50vw, calc(100vw - 40px)" alt="A pop engraving of a street of pink and lilac brownstone two-flats under a yellow sky: a man in an orange toga looks at a phone that shows a map pin." width="1280" height="706" loading="lazy" />
        </a>
        <div>
          <h2 id="proof" class="text-[32px] leading-tight sm:text-[38px]">Fridman Properties, Chicago</h2>
          <ul class="mt-6 grid grid-cols-3 gap-4">
            {
              caseNumbers.map((c) => (
                <li>
                  <p class="text-[30px] leading-none font-semibold sm:text-[36px]">{c.n}</p>
                  <p class="mt-2 text-[14px] text-muted">{c.text}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-[15px] text-muted">Baseline now, results at 90 days. Related party: the owner is CEO of MyRemotely, our partner.</p>
          <a href="/case-studies/fridman-properties" class="btn-primary mt-6">Read the case study</a>
        </div>
      </div>
    </section>

    <!-- 05 Fit -->
    <section aria-labelledby="fit-h" class="py-16">
      <p class="chapter" style="--chip:var(--color-lilac)"><b>05</b>Who it is for</p>
      <h2 id="fit-h" class="text-[36px] leading-[1.05] sm:text-[44px]">Only property management. On purpose.</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="rounded-md bg-mint/35 p-6">
          <p class="meta">A good fit</p>
          <ul class="mt-3 space-y-2 text-[16px]">
            {fit.yes.map((t) => <li class="flex gap-2"><span>✓</span>{t}</li>)}
          </ul>
        </div>
        <div class="rounded-md border border-rule bg-page p-6">
          <p class="meta">Not a fit</p>
          <ul class="mt-3 space-y-2 text-[16px] text-muted">
            {fit.no.map((t) => <li class="flex gap-2"><span>×</span>{t}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </div>

  <!-- 06 Pricing -->
  <section id="pricing" aria-labelledby="pricing-h" class="border-y border-rule bg-page py-16">
    <div class="wrap">
      <p class="chapter" style="--chip:var(--color-sky)"><b>06</b>Pricing</p>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="pricing-h" class="text-[36px] leading-[1.05] sm:text-[44px]">Clear prices, in public</h2>
        <div role="radiogroup" aria-label="Billing" class="billing inline-flex rounded-full border border-rule bg-parchment p-1 text-[13px]">
          <button type="button" role="radio" aria-checked="true" data-bill="month" class="bill-opt cursor-pointer rounded-full px-4 py-1.5">Month to month</button>
          <button type="button" role="radio" aria-checked="false" data-bill="year" class="bill-opt cursor-pointer rounded-full px-4 py-1.5">12 months</button>
        </div>
      </div>
      <p class="mt-3 text-muted">First prices. Stop any month.</p>
      <ul class="pricing-list mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          offers.filter((o) => o.slug !== "impact").map((o) => (
            <li class={`flex flex-col rounded-md p-6 ${o.slug === "growth" ? "bg-sun/35 ring-2 ring-sun" : "border border-rule bg-parchment"}`}>
              <h3 class="text-xl font-medium">{o.name}</h3>
              <p class="mt-3">
                <span
                  class="price text-[36px] font-semibold"
                  data-month={usd(o.price_usd_month)}
                  data-year={usd(("annual_price_usd_month" in o ? o.annual_price_usd_month : undefined) ?? o.price_usd_month)}
                >
                  {usd(o.price_usd_month)}
                </span>
                {o.price_usd_month > 0 && <span class="text-muted">/mo</span>}
              </p>
              {"annual_price_usd_month" in o && o.annual_price_usd_month !== undefined && (
                <p class="meta mt-1">
                  <span class="note-month">{usd(o.annual_price_usd_month)}/mo on 12 months</span>
                  <span class="note-year hidden">Save {usd((o.price_usd_month - o.annual_price_usd_month) * 12)} a year</span>
                </p>
              )}
              <ul class="mt-4 flex-1 space-y-1.5 text-[15px] text-muted">
                {o.scope.map((s) => (
                  <li class="flex gap-2">
                    <span class="text-minium">·</span>
                    {s}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="wrap">
    <!-- 07 FAQ -->
    <section id="faq" aria-labelledby="faq-h" class="grid gap-10 py-16 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="chapter" style="--chip:var(--color-coral)"><b>07</b>Questions</p>
        <h2 id="faq-h" class="text-[36px] leading-[1.05] sm:text-[44px]">GEO for property managers, answered</h2>
        <p class="meta mt-6">
          By <a rel="author" class="link normal-case" href="/about">Taras Kornichuk</a>, founder. Updated <time datetime="2026-10-18">2026-10-18</time>.
        </p>
      </div>
      <div class="border-t border-rule">
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p class="pb-6 text-[16px] text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section aria-labelledby="cta" class="grid items-center gap-10 overflow-hidden rounded-lg bg-lilac/30 p-6 sm:p-10 md:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 id="cta" class="text-[36px] leading-[1.05] sm:text-[44px]">Does ChatGPT name you in your city?</h2>
        <p class="mt-4 text-[17px] text-muted">Free audit: 20 landlord questions, 4 AI engines, your top 5 fixes.</p>
        <a class="btn-primary mt-6 !px-5 !py-3 !text-[15px]" href={auditHref}>Get the free audit</a>
      </div>
      <figure class="img-frame">
        <img src="/img/cta-v1-720.webp" srcset="/img/cta-v1-640.webp 640w, /img/cta-v1-960.webp 960w, /img/cta-v1-1280.webp 1280w, /img/cta-v1-1920.webp 1920w" sizes="(min-width: 768px) 50vw, calc(100vw - 40px)" alt="A pop engraving under a lilac sky: a man in an orange toga with a big key knocks on a mint-green door, a sealed letter in his hand and a cat on the step." width="1280" height="714" loading="lazy" />
      </figure>
    </section>
  </div>
  </main>
</Base>

<script>
  const group = document.querySelector<HTMLElement>(".billing");
  group?.addEventListener("click", (event) => {
    const opt = (event.target as HTMLElement).closest<HTMLButtonElement>(".bill-opt");
    if (!opt) return;
    const bill = opt.dataset.bill === "year" ? "year" : "month";
    for (const o of group.querySelectorAll(".bill-opt")) {
      o.setAttribute("aria-checked", String(o === opt));
    }
    for (const p of document.querySelectorAll<HTMLElement>(".pricing-list .price")) {
      p.textContent = p.dataset[bill] ?? "";
    }
    for (const n of document.querySelectorAll(".note-month")) n.classList.toggle("hidden", bill === "year");
    for (const n of document.querySelectorAll(".note-year")) n.classList.toggle("hidden", bill === "month");
  });
</script>

<style>
  .bill-opt[aria-checked="true"] {
    background: var(--color-minium);
    color: var(--color-page);
  }
</style>
