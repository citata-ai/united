---
import Base from "../layouts/Base.astro";
import PlatformRibbon from "../components/PlatformRibbon.astro";
import Mechanism from "../components/Mechanism.astro";
import PromptTester from "../components/PromptTester.astro";
import { auditHref, offers } from "../data/site.ts";
import { faq } from "../data/faq.ts";

// Copy sources: business/strategy.md (§1 one line, §2 process, §3 verticals, §5 facts),
// business/offers.toml (price ladder), business/case-studies/fridman-properties.md (demand trend,
// baseline). Every number names its source. Niche: US property management companies only.
const title = "citata.ai — GEO for property management companies";
const description =
  "Rental owners now ask ChatGPT and Gemini which property manager to hire. citata.ai gets your property management company named and linked in that answer.";

const facts = [
  {
    n: "−46%",
    text: "Google searches for 7 generic property management terms, Chicago area, year over year. −43% in the US.",
    src: "Keyword Planner, 2025/26 vs 2024/25 (our data)",
    href: "/case-studies/fridman-properties",
  },
  {
    n: "8 of 132",
    text: "owner answers named our first client, a Chicago manager with 20+ years. 0 of 6 for Section 8.",
    src: "our baseline, 144 AI answers, 2026-10-16",
    href: "/case-studies/fridman-properties",
  },
  {
    n: "0.5% → 12.1%",
    text: "AI sent 0.5% of visits to one site, but 12.1% of its signups. AI traffic is small, but it buys.",
    src: "Ahrefs",
    href: "https://ahrefs.com/blog/ai-search-traffic-conversions-ahrefs/",
  },
];

const ownerPrompts = [
  "best property management company in <city>",
  "property manager for my single-family rental in <city>",
  "property manager that handles Section 8 tenants",
  "how much does property management cost in <city>",
  "is it worth hiring a property manager for one rental",
];

const stages = [
  {
    n: "01",
    name: "Indexed",
    text: "Google, Bing and AI crawlers can read every owner page. We fix crawl errors, sitemaps, canonical tags and slow pages.",
  },
  {
    n: "02",
    name: "Found",
    text: "Your site answers the exact questions owners ask: fees, contracts, screening, Section 8, your cities. One page per question.",
  },
  {
    n: "03",
    name: "Mentioned",
    text: "ChatGPT, Gemini, Claude and Perplexity name your company, with a link, when an owner asks for a manager in your city.",
  },
];

const steps = [
  {
    head: "Send one sentence.",
    text: "Tell us your goal by email. Example: “Owners in Chicago find us when they ask AI for a manager.”",
  },
  {
    head: "We take a baseline.",
    text: "We ask 4 AI engines your owners’ questions and record which managers they name. No baseline, no proof.",
  },
  {
    head: "One checked change a day.",
    text: "Agents draft a page fix, an owner answer or a listing update. A person checks each one before it ships.",
  },
  {
    head: "A report every Monday.",
    text: "Which engines named you, for which owner questions, and what we changed. Short, with numbers.",
  },
];

const fit = {
  yes: [
    "US property management companies with 50 to 500 doors",
    "Single-family homes and small multifamily",
    "You sell to rental owners and want more owner leads",
    "Section 8 and affordable housing managers",
  ],
  no: [
    "Large apartment communities that need renter leads: listing sites win those answers (72% of AI citations, Peek)",
    "HOA and condo association management",
    "Any business outside property management",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO and AEO for property management companies",
  serviceType: "Generative engine optimization",
  provider: { "@id": "https://citata.ai/#org" },
  areaServed: { "@type": "Country", name: "United States" },
  audience: { "@type": "BusinessAudience", name: "Property management companies with 50 to 500 doors" },
  description:
    "Done-for-you GEO: weekly tracking of owner questions on ChatGPT, Gemini, Claude and Perplexity, one human-checked change a day, and a Monday report.",
  offers: [
    { "@type": "Offer", name: "Free AI visibility audit", price: 0, priceCurrency: "USD" },
    { "@type": "Offer", name: "Starter", price: 750, priceCurrency: "USD" },
    { "@type": "Offer", name: "Growth", price: 2000, priceCurrency: "USD" },
  ],
};

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "GEO for property management companies",
  description,
  author: { "@type": "Person", "@id": "https://citata.ai/about#founder", name: "Taras Kornichuk", jobTitle: "Founder", url: "https://citata.ai/about" },
  publisher: { "@id": "https://citata.ai/#org" },
  datePublished: "2026-10-18",
  dateModified: "2026-10-18",
  mainEntityOfPage: "https://citata.ai/",
  about: ["Generative engine optimization", "Property management"],
};

const usd = (n: number) => (n === 0 ? "$0" : `$${n.toLocaleString("en-US")}`);
---

<Base title={title} description={description} image="/og/hero.jpg" modified="2026-10-18">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(article)} />
  </Fragment>
  <main>
  <div class="wrap">
    <section class="grid items-center gap-10 py-12 md:grid-cols-[1.15fr_1fr] md:py-16">
      <div>
        <p class="meta"><span class="text-minium">GEO + AEO</span> · for property management companies</p>
        <h1 class="mt-4 text-[40px] leading-[1.04] sm:text-[56px] sm:leading-[1.02]">
          Get named when owners ask AI for a property manager
        </h1>
        <p class="mt-5 max-w-xl text-[19px] leading-normal text-muted">
          Fewer owner leads from Google? More rental owners now ask ChatGPT or Gemini who to hire.
          citata.ai gets your property management company named and linked in that answer. We do the
          work.
        </p>
        <ul class="mt-6 grid max-w-xl gap-3 text-[15px] sm:grid-cols-3">
          <li class="border-t border-rule pt-3">
            <span class="meta text-minium">01 Track</span>
            <span class="mt-1 block text-muted">The questions your buyers ask AI</span>
          </li>
          <li class="border-t border-rule pt-3">
            <span class="meta text-minium">02 Fix</span>
            <span class="mt-1 block text-muted">One checked change to your site a day</span>
          </li>
          <li class="border-t border-rule pt-3">
            <span class="meta text-minium">03 Report</span>
            <span class="mt-1 block text-muted">Who named you, every Monday</span>
          </li>
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn-primary" href={auditHref}>Get a free AI visibility audit</a>
          <a class="btn-secondary" href="#engine">See how it works</a>
        </div>
        <p class="mt-4 text-sm text-muted">
          The audit is free: 20 owner questions on 4 AI engines, and your top 5 fixes.
        </p>
      </div>
      <figure class="img-frame">
        <img
          src="/img/hero-720.webp" srcset="/img/hero-640.webp 640w, /img/hero-720.webp 720w, /img/hero-960.webp 960w, /img/hero-1280.webp 1280w" sizes="(min-width: 768px) 50vw, calc(100vw - 40px)"
          alt="A marble hand points at one open book on a shelf. A chat bubble sits above the book."
          width="1280"
          height="714"
          fetchpriority="high"
        />
      </figure>
    </section>
  </div>

  <PlatformRibbon />

  <div class="wrap">
    <section aria-labelledby="engine" class="border-b border-rule py-14">
      <p class="label" id="engine">How the work flows</p>
      <Mechanism />
    </section>

    <section aria-labelledby="why" class="border-b border-rule py-14">
      <p class="label" id="why">Why owner leads drop</p>
      <ul class="grid gap-8 md:grid-cols-3">
        {
          facts.map((f) => (
            <li>
              <p class="text-[40px] leading-none font-semibold">{f.n}</p>
              <p class="mt-3 text-[17px]">{f.text}</p>
              <p class="meta mt-2">
                Source: <a class="link normal-case" href={f.href}>{f.src}</a>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-[66ch] text-muted">
        An owner who asks AI for a manager gets 3 to 5 names, not 10 blue links. If AI does not know
        your company, that owner may never hear your name. We think part of the lost search demand went
        to these answers. That is a hypothesis, and we test it each week.
      </p>
    </section>

    <section aria-labelledby="ask" class="border-b border-rule py-14">
      <p class="label">The questions</p>
      <h2 id="ask" class="text-[32px] leading-tight">What your owners ask AI</h2>
      <p class="mt-3 max-w-[66ch] text-muted">
        We track questions like these every week, on ChatGPT, Gemini, Claude and Perplexity. For each
        one we record if the answer names you, and if it links to your site.
      </p>
      <ul class="mt-8 grid gap-3 md:grid-cols-2">
        {
          ownerPrompts.map((p) => (
            <li class="rounded border border-rule bg-page px-5 py-4 font-mono text-[13px]">“{p}”</li>
          ))
        }
      </ul>
      <a href="/property-management" class="link mt-6 inline-block">Owner vs renter questions, and the Section 8 angle →</a>
    </section>

    <section id="how" aria-labelledby="how-h" class="border-b border-rule py-14">
      <p class="label">How it works</p>
      <h2 id="how-h" class="text-[32px] leading-tight">Indexed → Found → Mentioned</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          stages.map((s) => (
            <li class="rounded border border-rule bg-page p-6">
              <p class="meta text-minium">{s.n}</p>
              <h3 class="mt-2 text-[22px]">{s.name}</h3>
              <p class="mt-2 text-[15px] text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 grid items-center gap-10 md:grid-cols-[1.3fr_1fr]">
      <ol class="grid gap-y-6">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="meta mt-1 w-6 flex-none">{i + 1}.</span>
              <p>
                <strong class="font-medium">{s.head}</strong>{" "}
                <span class="text-muted">{s.text}</span>
              </p>
            </li>
          ))
        }
      </ol>
        <figure class="img-frame">
          <img src="/img/monday-report-720.webp" srcset="/img/monday-report-640.webp 640w, /img/monday-report-720.webp 720w, /img/monday-report-960.webp 960w, /img/monday-report-1280.webp 1280w" sizes="(min-width: 768px) 50vw, calc(100vw - 40px)" alt="A marble bust reads a newspaper with a small bar chart. A brass bell stands beside it." width="1280" height="714" loading="lazy" />
        </figure>
      </div>
    </section>

    <section aria-labelledby="proof" class="my-14 rounded-md border border-rule bg-page p-6 sm:p-10">
      <div class="grid items-center gap-8 md:grid-cols-[1fr_1.1fr]">
        <a href="/case-studies/fridman-properties" class="img-frame block">
          <img src="/img/fridman-case-720.webp" srcset="/img/fridman-case-640.webp 640w, /img/fridman-case-720.webp 720w, /img/fridman-case-960.webp 960w, /img/fridman-case-1280.webp 1280w" sizes="(min-width: 768px) 50vw, calc(100vw - 40px)" alt="A marble statue looks at a phone with a map pin, in front of a brownstone and a column." width="1280" height="714" loading="lazy" />
        </a>
        <div>
          <p class="label" id="proof">Case study · in progress</p>
          <h2 class="text-[32px] leading-tight">Fridman Properties: the baseline before the work</h2>
          <p class="mt-4 text-muted">
            We moved a Chicago manager’s 90-page site to a fast static stack and kept every URL, word and
            SEO tag. Then we asked 3 AI engines 24 owner questions. Outside its own name, AI named the
            company in 8 of 132 answers. We publish the plan and the baseline now, and the results at 90
            days. Related party: the owner is also the CEO of MyRemotely, a partner of ours.
          </p>
          <a href="/case-studies/fridman-properties" class="mt-6 inline-block text-minium underline underline-offset-2">
            Read the case study →
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="fit-h" class="border-b border-rule pb-14">
      <p class="label">Who it is for</p>
      <h2 id="fit-h" class="text-[32px] leading-tight">Only property management. On purpose.</h2>
      <p class="mt-3 max-w-[66ch] text-muted">
        We work in one niche, so we know the owner questions, the sources AI reads and the Fair Housing
        rules. If we cannot help you, we will say so.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded border border-rule bg-page p-6">
          <p class="meta text-verdigris">A good fit</p>
          <ul class="mt-3 space-y-2 text-[15px]">
            {fit.yes.map((t) => <li class="flex gap-2"><span class="text-verdigris">·</span>{t}</li>)}
          </ul>
        </div>
        <div class="rounded border border-rule bg-page p-6">
          <p class="meta text-minium">Not a fit</p>
          <ul class="mt-3 space-y-2 text-[15px] text-muted">
            {fit.no.map((t) => <li class="flex gap-2"><span class="text-minium">·</span>{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="pricing" aria-labelledby="pricing-h" class="border-b border-rule py-14">
      <p class="label">Pricing</p>
      <h2 id="pricing-h" class="text-[32px] leading-tight">Clear prices, in public.</h2>
      <p class="mt-3 max-w-[66ch] text-muted">
        These are our first prices. We will check them with our first 3 paying clients and may change
        them. You can stop any month.
      </p>
      <div role="radiogroup" aria-label="Billing" class="billing mt-6 inline-flex rounded border border-rule p-0.5 text-[13px]">
        <button type="button" role="radio" aria-checked="true" data-bill="month" class="bill-opt cursor-pointer rounded-sm px-3 py-1">Month to month</button>
        <button type="button" role="radio" aria-checked="false" data-bill="year" class="bill-opt cursor-pointer rounded-sm px-3 py-1">12 months</button>
      </div>
      <ul class="pricing-list mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          offers.filter((o) => o.slug !== "impact").map((o) => (
            <li class={`flex flex-col rounded border bg-page p-6 ${o.slug === "growth" ? "border-minium" : "border-rule"}`}>
              <h3 class="text-xl font-medium">{o.name}</h3>
              <p class="mt-3">
                <span
                  class="price text-[32px] font-semibold"
                  data-month={usd(o.price_usd_month)}
                  data-year={usd(("annual_price_usd_month" in o ? o.annual_price_usd_month : undefined) ?? o.price_usd_month)}
                >
                  {usd(o.price_usd_month)}
                </span>
                {o.price_usd_month > 0 && <span class="text-muted">/mo</span>}
              </p>
              {"annual_price_usd_month" in o && o.annual_price_usd_month !== undefined && (
                <p class="meta mt-1">
                  <span class="note-month">{usd(o.annual_price_usd_month)}/mo on 12 months</span>
                  <span class="note-year hidden">Save {usd((o.price_usd_month - o.annual_price_usd_month) * 12)} a year</span>
                </p>
              )}
              <ul class="mt-4 flex-1 space-y-1.5 text-[15px] text-muted">
                {o.scope.map((s) => (
                  <li class="flex gap-2">
                    <span class="text-minium">·</span>
                    {s}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <a class="btn-primary mt-8" href={auditHref}>Start with the free audit</a>
    </section>

    <section aria-labelledby="try" class="grid gap-10 border-b border-rule py-14 md:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="label">Test it yourself</p>
        <h2 id="try" class="text-[32px] leading-tight">Ask AI what your buyers ask</h2>
        <p class="mt-3 max-w-[48ch] text-muted">
          Type your city. Open each question in an engine and read the answer. If your company is not in
          it, the buyer may never hear your name. This is the first step of our audit.
        </p>
      </div>
      <PromptTester />
    </section>

    <section id="faq" aria-labelledby="faq-h" class="border-b border-rule py-14">
      <p class="label">Questions</p>
      <h2 id="faq-h" class="text-[32px] leading-tight">GEO for property managers, answered</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {
          faq.map((f) => (
            <div>
              <h3 class="text-[19px] font-medium">{f.q}</h3>
              <p class="mt-2 text-[15px] text-muted">{f.a}</p>
            </div>
          ))
        }
      </div>
      <p class="meta mt-10">
        Written by <a rel="author" class="link normal-case" href="/about">Taras Kornichuk</a>, founder of citata.ai.
        Updated <time datetime="2026-10-18">2026-10-18</time>.
      </p>
    </section>

    <section aria-labelledby="cta" class="grid items-center gap-8 pt-14 md:grid-cols-[1.2fr_1fr]">
      <h2 id="cta" class="text-[36px] leading-[1.05] sm:text-[44px]">
        Does ChatGPT name your company in your city? <span class="text-minium">Find out for free.</span>
      </h2>
      <div>
        <p class="text-muted">
          Email us your site and the cities you serve. We ask 4 AI engines 20 questions your owners ask,
          check your index, and send a one-page report with your top 5 fixes. If we cannot help, we will
          say so.
        </p>
        <a class="btn-primary mt-5" href={auditHref}>Email grow@citata.ai</a>
      </div>
    </section>
  </div>
  </main>
</Base>

<script>
  const group = document.querySelector<HTMLElement>(".billing");
  group?.addEventListener("click", (event) => {
    const opt = (event.target as HTMLElement).closest<HTMLButtonElement>(".bill-opt");
    if (!opt) return;
    const bill = opt.dataset.bill === "year" ? "year" : "month";
    for (const o of group.querySelectorAll(".bill-opt")) {
      o.setAttribute("aria-checked", String(o === opt));
    }
    for (const p of document.querySelectorAll<HTMLElement>(".pricing-list .price")) {
      p.textContent = p.dataset[bill] ?? "";
    }
    for (const n of document.querySelectorAll(".note-month")) n.classList.toggle("hidden", bill === "year");
    for (const n of document.querySelectorAll(".note-year")) n.classList.toggle("hidden", bill === "month");
  });
</script>

<style>
  .bill-opt[aria-checked="true"] {
    background: var(--color-minium);
    color: var(--color-page);
  }
</style>
