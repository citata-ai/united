---
import Base from "../../layouts/Base.astro";
import type { GuideFrontmatter } from "../../layouts/Guide.astro";
import { coverSrcset, guideCovers } from "../../data/guide-covers.ts";

const title = "Guides: AI search for property management companies — citata.ai";
const description =
  "Short guides for property managers: why owner leads drop, how owners use AI to pick a manager, and how to get named in AI answers.";

const guides = Object.values(
  import.meta.glob<{ frontmatter: GuideFrontmatter; url: string }>("./*.md", { eager: true }),
).sort((a, b) => b.frontmatter.updated.localeCompare(a.frontmatter.updated));
---

<Base title={title} description={description}>
  <main class="wrap">
    <section class="border-b border-rule py-12 md:py-16">
      <p class="meta"><span class="text-minium">Guides</span> · AI search for property managers</p>
      <h1 class="mt-4 max-w-3xl text-[38px] leading-[1.04] sm:text-[52px]">How owners find a property manager now</h1>
      <p class="mt-5 max-w-[66ch] text-[19px] text-muted">
        Each guide answers one question that property managers ask us. Every number names its source.
      </p>
    </section>
    <ul class="divide-y divide-rule">
      {
        guides.map((g) => (
          <li class="py-8">
            <a href={g.url} class="group grid max-w-4xl items-start gap-6 sm:grid-cols-[240px_1fr]">
              {guideCovers[g.url.split("/").pop() ?? ""] && (
                <figure class="img-frame">
                  <img
                    src={`/img/${guideCovers[g.url.split("/").pop() ?? ""].img}-640.webp`}
                    srcset={coverSrcset(guideCovers[g.url.split("/").pop() ?? ""].img)}
                    sizes="240px"
                    alt=""
                    width="640"
                    height="357"
                    loading="lazy"
                  />
                </figure>
              )}
              <div>
              <h2 class="text-[26px] leading-tight group-hover:text-minium">{g.frontmatter.headline}</h2>
              <p class="mt-2 text-muted">{g.frontmatter.dek}</p>
              <p class="meta mt-3">Updated {g.frontmatter.updated}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
