---
import AuditCta from "../components/AuditCta.astro";
import Base from "../layouts/Base.astro";

// Facts: business/marketing/listing-kit.md (company facts, founder line),
// business/strategy.md (§4 dog food accounts, §7 related parties). Do not add a fact that is not there.
const title = "About Citata.ai — a GEO agency for property management companies";
const description =
  "Who runs Citata.ai, why we work only with property management companies, and how we check our own claims.";

const facts = [
  ["Company", "Citata.ai, a trade name of WarmDevs OÜ"],
  ["Registry code", "16788177, Estonian Business Register"],
  ["VAT", "EE102647727"],
  ["Address", "Sepapaja tn 6, 15551 Tallinn, Estonia (registered address)"],
  ["Founder", "Taras Kornichuk (Tao)"],
  ["Team", "Remote. People and AI agents."],
  ["Clients", "US property management companies"],
  ["Email", "grow@citata.ai"],
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://citata.ai/about#founder",
  name: "Taras Kornichuk",
  alternateName: "Tao",
  jobTitle: "Founder",
  worksFor: { "@id": "https://citata.ai/#org" },
  url: "https://citata.ai/about",
  knowsAbout: ["Generative engine optimization", "AI search visibility", "Property management marketing"],
};
---

<Base title={title} description={description} modified="2026-10-18">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </Fragment>
  <main class="wrap">
    <section class="mt-8 rounded-lg bg-mint/35 p-6 sm:p-12">
      <p class="meta"><span class="text-minium">About</span> · Citata.ai</p>
      <h1 class="mt-4 max-w-3xl text-[38px] leading-[1.04] sm:text-[52px] sm:leading-[1.02]">
        A small GEO agency for property management companies
      </h1>
      <p class="mt-5 max-w-[66ch] text-[19px] text-muted">
        Citata.ai gets property management companies named and linked when landlords ask AI
        assistants who to hire. GEO (generative engine optimization) is the name for this work.
      </p>
    </section>

    <section aria-labelledby="who" class="grid gap-10 py-14 md:grid-cols-[1.2fr_1fr]">
      <div class="prose-c">
        <h2 id="who">Who does the work</h2>
        <p>
          I am Taras Kornichuk, the founder. People call me Tao. I build the delivery system with AI
          agents, and I check each output by hand before it goes live.
        </p>
        <p>
          Agents do the repeat work: they ask AI engines the same landlord questions each week, read the
          answers and draft page fixes. A person decides what ships. We do not publish bulk AI text.
        </p>
        <h2>Why only property management</h2>
        <p>
          Our partner MyRemotely builds AI leasing agents, and its clients are property managers. We
          are the marketing arm that MyRemotely offers them. Our first client is a Chicago property
          manager.
        </p>
        <p>
          One niche lets us go deep. We know which questions landlords ask, which sites AI reads for the
          answer, and which Fair Housing rules apply to the copy.
        </p>
        <h2>How we check our own claims</h2>
        <p>
          Each number on this site names its source. We take a baseline before we change a site, so
          a result has a before and an after. We do not promise rankings or citations. AI answers
          change from run to run, so we report what happened.
        </p>
        <p>
          We test on our own site first. On 2026-10-18 we asked ChatGPT, Gemini and Claude 20
          questions about GEO for property managers. They named Citata.ai in 0 of 108 answers. We
          publish that number, and we will publish the next ones.
        </p>
        <h2>Related parties</h2>
        <p>
          Our first accounts are close to us. Ran Fridman owns Fridman Properties, our first case
          study, and he is the CEO of MyRemotely, our partner. Each case study says so at the top.
        </p>
      </div>
      <aside class="self-start rounded-md bg-sun/30 p-6">
        <p class="meta text-minium">Company facts</p>
        <table class="mt-4 w-full text-[15px]">
          <tbody>
            {
              facts.map(([k, v]) => (
                <tr class="border-t border-rule">
                  <th class="py-2 pr-4 text-left align-top font-normal text-muted">{k}</th>
                  <td class="py-2">{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-4 text-[13px] text-muted">
          Not the same company as Citate.ai, Citant.ai, Citala or Citeca.
        </p>
      </aside>
    </section>

    <AuditCta title="Want to know what AI says about your company?" />
  </main>
</Base>
