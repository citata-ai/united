---
// H03-E1: original data page. Numbers come from summary.json of the 2026-10-19 run
// (tools/ai-visibility/cities_analyze.py), copied to src/data/ai-pm-index-2026.json.
// Voice: brand/VOICE.md. Report counts only; no company is named in a negative way.
import Guide, { type GuideFrontmatter } from "../../layouts/Guide.astro";
import data from "../../data/ai-pm-index-2026.json";
import ch from "../../data/ai-pm-index-2026-change.json";
import src from "../../data/ai-pm-index-2026-sources.json";

const o = data.overall;
const e = data.by_engine;
const pct = (n: number, d: number) => Math.round((100 * n) / d);
const N = o.answers;
const date = o.dates[0];
const csvUrl = "/data/ai-property-manager-index-2026.csv";
const pageUrl = "https://citata.ai/research/ai-property-manager-index-2026";
const dom = (name: string) => data.top_domains.find((d) => d.domain === name)?.answers ?? 0;
const expertise = dom("expertise.com");
const yelp = dom("yelp.com");
const ipm = dom("ipropertymanagement.com");
const rpm = data.top_national[0];
const engineName: Record<string, string> = { chatgpt: "ChatGPT", gemini: "Gemini", claude: "Claude" };
const engineOrder = ["chatgpt", "gemini", "claude"] as const;
const typeLabel: Record<string, string> = {
  directory: "Directories, review, list and social sites",
  company: "Property management company sites",
  data: "Company data sites",
  forum: "Forums (Reddit, BiggerPockets)",
  media: "Local news and city blogs",
  reference: "Reference (Wikipedia, national press)",
  association: "Trade associations (NARPM)",
  other: "Other",
};
// Update 1 (B026): same prompts, models and cities, run again. Numbers come from change.json (tools/ai-visibility/cities_compare.py).
const d2 = ch.new_date;
const csv2Url = `/data/ai-property-manager-index-2026-11-02.csv`;
const r = ch.retention;
const exp2 = ch.domains.find((x) => x.domain === "expertise.com") ?? { domain: "expertise.com", old: 0, new: 0, delta: 0 };
const sign = (n: number) => (n > 0 ? `+${n}` : `${n}`);
const changeRows = [
  { key: "avg_companies", label: "Companies named per answer", unit: "" },
  { key: "pct_names_local", label: "Names that are local firms", unit: "%" },
  { key: "pct_with_national", label: "Answers with a national or multi-state brand", unit: "%" },
  { key: "pct_with_listing_site", label: "Answers with a directory or review site", unit: "%" },
  { key: "pct_with_company_site", label: "Answers that link a company site", unit: "%" },
  { key: "pct_with_forum", label: "Answers with Reddit or BiggerPockets", unit: "%" },
] as const;
// Update 2 (B034): ChatGPT and Claude only (Gemini: our API access stopped on 2026-11-16). Numbers come from sources.json
// (tools/ai-visibility/cities_sources.py). Goodjuju numbers: their study page, read 2026-11-16 (cities of 30, one run, 2026-10-30).
const d3 = src.dates[src.dates.length - 1];
const csv3Url = `/data/ai-property-manager-index-2026-11-16.csv`;
const gjUrl = "https://gogoodjuju.com/property-management-ai-search-study/";
type Eng = "chatgpt" | "claude";
const se = src.engines as Record<Eng, { dates: string[]; per_date: Record<string, { answers: number; avg_sources: number; distinct_domains: number }>; top: Record<string, number | string>[]; core: string[] }>;
const srcEngines: Eng[] = ["chatgpt", "claude"];
const n3 = (k: Eng) => se[k].per_date[d3].answers;
const w = (dom: string, k: Eng, d: string) => ((src.watch.find((x) => x.domain === dom) as any)?.[k]?.[d] ?? 0) as number;
const tp = (k: Eng, dom: string, d: string) => (se[k].top.find((x) => x.domain === dom)?.[d] ?? 0) as number;
const share = (n: number, of: number) => `${Math.round((100 * n) / of)}%`;
const gj: { domain: string; chatgpt: number | null; claude: number | null }[] = [
  { domain: "expertise.com", chatgpt: 10, claude: 16 },
  { domain: "propertymanagement.com", chatgpt: 5, claude: 15 },
  { domain: "ipropertymanagement.com", chatgpt: 1, claude: 14 },
  { domain: "awning.com", chatgpt: null, claude: 14 },
  { domain: "biggerpockets.com", chatgpt: 5, claude: 9 },
  { domain: "bestinhood.com", chatgpt: 11, claude: null },
  { domain: "yelp.com", chatgpt: null, claude: 2 },
  { domain: "birdeye.com", chatgpt: 3, claude: null },
  { domain: "trustanalytica.org", chatgpt: 3, claude: null },
  { domain: "threebestrated.com", chatgpt: null, claude: 4 },
  { domain: "thumbtack.com", chatgpt: null, claude: 4 },
  { domain: "reddit.com", chatgpt: null, claude: null },
];
const gjCell = (n: number | null) => (n === null ? "–" : `${n} (${share(n, 30)})`);
const types = Object.entries(o.source_type_answers as Record<string, number>).sort((a, b) => b[1] - a[1]);

const fm: GuideFrontmatter = {
  title: "AI Property Manager Index 2026: Who AI Names in 50 Cities — Citata.ai",
  description: `We asked ChatGPT, Gemini and Claude for the best property manager in the 50 largest US cities. ${N} answers: who they name and which sources they cite.`,
  headline: "AI Property Manager Index 2026",
  dek: `Who ChatGPT, Gemini and Claude name as the best property manager in 50 US cities, and the sources they use.`,
  published: date,
  updated: d3,
  answer: `We asked ChatGPT, Gemini and Claude "What is the best property management company in <city>?" for the 50 largest US cities (${N} answers, ${date}). The engines named ${o.distinct_companies} different companies, and ${Math.round(o.pct_names_local)}% of all names were local firms. ${pct(o.answers_with_listing_site, N)}% of answers used a directory or review site as a source; Expertise.com was a source in ${expertise} of ${N} answers. Gemini linked a property manager's own site in ${pct(e.gemini.answers_with_company_site, 50)}% of answers, ChatGPT in ${pct(e.chatgpt.answers_with_company_site, 50)}%. When we asked again on ${d2}, only ${Math.round(r.all.pct_kept)}% of the names came back, but the top sources stayed the same. On ${d3}, ChatGPT used Expertise.com in only ${w("expertise.com", "chatgpt", d3)} of ${n3("chatgpt")} answers (first run: ${w("expertise.com", "chatgpt", date)} of 50), while Claude still used Yelp, Expertise.com and iPropertyManagement.com in most cities.`,
  faq: [
    {
      q: "Which property management company does ChatGPT recommend?",
      a: `It depends on the city. In our ${date} test, ChatGPT named ${e.chatgpt.avg_companies} companies per answer on average, and ${Math.round(e.chatgpt.pct_names_local)}% of them were local firms. The full list for each of the 50 cities is in the table and the free CSV on this page.`,
    },
    {
      q: "Where does AI get its property manager recommendations?",
      a: `Mostly from directories and review sites. Expertise.com was a source in ${expertise} of ${N} answers, Yelp in ${yelp} and iPropertyManagement.com in ${ipm}. Gemini also used company sites and Reddit; ChatGPT used directories in ${pct(e.chatgpt.answers_with_listing_site, 50)}% of its answers.`,
    },
    {
      q: "How can a property management company get recommended by AI?",
      a: "Be on the sources the engines read for your city: Expertise.com, Yelp, iPropertyManagement.com, BBB, Birdeye and the local best-of lists. Keep your own site clear about the city, the services and the fees, because Gemini and Claude link company sites often. No one can promise a place in an AI answer.",
    },
    {
      q: "Which sources does ChatGPT use for property managers now?",
      a: `In our ${d3} run, ChatGPT used Birdeye in ${w("birdeye.com", "chatgpt", d3)} of ${n3("chatgpt")} answers and ThePropertyManagementDirectory.com in ${tp("chatgpt", "thepropertymanagementdirectory.com", d3)}. Expertise.com fell from ${w("expertise.com", "chatgpt", date)} of 50 answers (${date}) to ${w("expertise.com", "chatgpt", d3)}. ChatGPT gives about ${se.chatgpt.per_date[d3].avg_sources} sources per answer, so one new directory can change many cities.`,
    },
    {
      q: "Are these AI recommendations stable?",
      a: `No. We asked the same ${N} questions again 14 days later (${d2}). Only ${Math.round(r.all.pct_kept)}% of the names came back (${r.all.kept.toLocaleString("en-US")} of ${r.all.old_names.toLocaleString("en-US")}), and ${r.all.same_list} of ${N} answers gave the same list. The sources were more stable: Expertise.com was a source in ${exp2.old} answers, then ${exp2.new}.`,
    },
  ],
  sources: [
    { label: `Citata.ai: AI Property Manager Index update 2, ${src.cities.length} cities, ChatGPT and Claude, ${d3} (CSV, our data)`, url: `https://citata.ai${csv3Url}` },
    { label: "Goodjuju Marketing: Where AI search gets its best property managers (30 cities, 4 engines, data collected 2026-10-30)", url: gjUrl },
    { label: `Citata.ai: AI Property Manager Index data, ${N} answers, ${date} (CSV, our data)`, url: `https://citata.ai${csvUrl}` },
    { label: `Citata.ai: AI Property Manager Index update 1, ${ch.overall.answers.new} answers, ${d2} (CSV, our data)`, url: `https://citata.ai${csv2Url}` },
    {
      label: "Wikipedia: List of United States cities by population (US Census Bureau estimates, July 1, 2025)",
      url: "https://en.wikipedia.org/wiki/List_of_United_States_cities_by_population",
    },
    { label: "Citata.ai: How owners choose a property manager with AI", url: "https://citata.ai/guides/how-owners-choose-a-property-manager-with-ai" },
  ],
};

const headings = [
  { depth: 2, slug: "numbers", text: "Headline numbers" },
  { depth: 2, slug: "update-2", text: `Update 2: the sources each engine uses` },
  { depth: 2, slug: "update-1", text: `Update 1: what changed in 14 days` },
  { depth: 2, slug: "method", text: "How we ran the test" },
  { depth: 2, slug: "companies", text: "Which companies AI names" },
  { depth: 2, slug: "sources", text: "Which sources AI uses" },
  { depth: 2, slug: "engines", text: "ChatGPT vs Gemini vs Claude" },
  { depth: 2, slug: "cities", text: "Results for each city" },
  { depth: 2, slug: "what-to-do", text: "What this means for property managers" },
  { depth: 2, slug: "data", text: "Download the data" },
];

const dataset = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "AI Property Manager Index 2026",
  description: `${N} answers from ChatGPT, Gemini and Claude (with web search) to "What is the best property management company in <City, ST>? Give names." for the 50 most populous US cities, with the companies named and the source domains.`,
  url: pageUrl,
  sameAs: `https://citata.ai${csvUrl}`,
  creator: { "@id": "https://citata.ai/#org" },
  publisher: { "@id": "https://citata.ai/#org" },
  datePublished: date,
  dateModified: d3,
  temporalCoverage: `${date}/${d3}`,
  spatialCoverage: { "@type": "Place", name: "United States" },
  license: "https://creativecommons.org/licenses/by/4.0/",
  isAccessibleForFree: true,
  keywords: ["property management", "AI search", "GEO", "ChatGPT", "Gemini", "Claude", "local search", "citations"],
  measurementTechnique: "One prompt per city, one run per engine, through each engine's API with web search on. A second model listed the company names in each answer.",
  variableMeasured: ["companies named", "national or multi-state brands named", "source domains", "links to company sites"],
  distribution: [
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `https://citata.ai${csvUrl}` },
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `https://citata.ai${csv2Url}` },
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `https://citata.ai${csv3Url}` },
  ],
};

// Chart data: top cited domains (one series, one color, direct labels).
const bars = data.top_domains.slice(0, 15);
const barMax = N;
const rowH = 26;
const labelW = 190;
const chartW = 640;
const plotW = chartW - labelW - 60;

const metrics = [
  { key: "avg_companies", label: "Companies named per answer", unit: "" },
  { key: "pct_names_local", label: "Names that are local firms", unit: "%" },
  { key: "pct_with_listing_site", label: "Answers with a directory or review site", unit: "%" },
  { key: "pct_with_company_site", label: "Answers that link a company site", unit: "%" },
  { key: "pct_with_forum", label: "Answers with Reddit or BiggerPockets", unit: "%" },
  { key: "avg_sources", label: "Source domains per answer", unit: "" },
] as const;
const fmt = (v: number, unit: string) => (unit === "%" ? `${Math.round(v)}%` : v.toFixed(1));
---

<Guide frontmatter={fm} url="/research/ai-property-manager-index-2026" headings={headings} schema={[dataset]}>
  <p>
    This is a new format for us: a small study with open data. Tell us what you think at
    <a href="mailto:grow@citata.ai">grow@citata.ai</a>.
  </p>
  <p>
    Disclosure: citata.ai sells GEO services (GEO: work that gets a company named in AI answers) to property
    management companies. None of our clients was named in this data. We report counts only. A count is not a
    rating of any company.
  </p>

  <h2 id="numbers">Headline numbers</h2>
  <p>We asked 3 AI engines one question for each of the 50 largest US cities. Here is what {N} answers show (our data, {date}).</p>
  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-md bg-sun/30 p-5">
      <p class="text-[34px] leading-none">{o.distinct_companies}</p>
      <p class="mt-2 text-[15px] text-muted">different companies named in {N} answers. {Math.round(o.pct_names_local)}% of all names were local firms.</p>
    </div>
    <div class="rounded-md bg-mint/40 p-5">
      <p class="text-[34px] leading-none">{pct(o.answers_with_listing_site, N)}%</p>
      <p class="mt-2 text-[15px] text-muted">of answers used a directory or review site as a source. Expertise.com: {expertise} of {N}.</p>
    </div>
    <div class="rounded-md bg-sky/25 p-5">
      <p class="text-[34px] leading-none">{pct(o.answers_with_company_site, N)}%</p>
      <p class="mt-2 text-[15px] text-muted">
        of answers linked a property manager's own site. Gemini: {pct(e.gemini.answers_with_company_site, 50)}%. ChatGPT: {pct(e.chatgpt.answers_with_company_site, 50)}%.
      </p>
    </div>
    <div class="rounded-md bg-lilac/30 p-5">
      <p class="text-[34px] leading-none">{pct(o.answers_with_national, N)}%</p>
      <p class="mt-2 text-[15px] text-muted">of answers named at least one national or multi-state brand. {rpm.name} came up most: {rpm.answers} answers, {rpm.cities} cities.</p>
    </div>
    <div class="rounded-md bg-coral/25 p-5 sm:col-span-2">
      <p class="text-[34px] leading-none">{o.cities_with_full_agreement} of 50</p>
      <p class="mt-2 text-[15px] text-muted">cities had at least one company that all 3 engines named. In the other {50 - o.cities_with_full_agreement} cities, the engines did not agree on any name.</p>
    </div>
  </div>

  <h2 id="update-2">Update 2: the sources each engine uses</h2>
  <p>
    ChatGPT changed its sources in 4 weeks. Claude kept its top 3: Yelp, Expertise.com and iPropertyManagement.com. On {d3} we sent the same prompt to ChatGPT and Claude for the same 50 cities
    ({n3("chatgpt") + n3("claude")} answers received, {100 - n3("chatgpt") - n3("claude")} failed). Gemini is not in this update: our API access to it stopped on {d3}.
    This update looks at sources only. We changed the model that lists the company names (from Claude Haiku 4.5 to Claude Haiku 5.5), so we do not compare names here.
  </p>
  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-md bg-coral/25 p-5">
      <p class="text-[34px] leading-none">{w("expertise.com", "chatgpt", date)} → {w("expertise.com", "chatgpt", d2)} → {w("expertise.com", "chatgpt", d3)}</p>
      <p class="mt-2 text-[15px] text-muted">ChatGPT answers that used Expertise.com ({date}, {d2}, {d3}; of 50, 50 and {n3("chatgpt")}).</p>
    </div>
    <div class="rounded-md bg-sun/30 p-5">
      <p class="text-[34px] leading-none">0 → {tp("chatgpt", "thepropertymanagementdirectory.com", d2)} → {tp("chatgpt", "thepropertymanagementdirectory.com", d3)}</p>
      <p class="mt-2 text-[15px] text-muted">ChatGPT answers that used ThePropertyManagementDirectory.com. Birdeye went {w("birdeye.com", "chatgpt", date)} → {w("birdeye.com", "chatgpt", d3)}.</p>
    </div>
    <div class="rounded-md bg-mint/40 p-5">
      <p class="text-[34px] leading-none">{w("yelp.com", "claude", d3)} of {n3("claude")}</p>
      <p class="mt-2 text-[15px] text-muted">Claude answers that used Yelp. Expertise.com: {w("expertise.com", "claude", d3)}. iPropertyManagement.com: {w("ipropertymanagement.com", "claude", d3)}.</p>
    </div>
    <div class="rounded-md bg-sky/25 p-5">
      <p class="text-[34px] leading-none">{src.cities_with_shared} of 50</p>
      <p class="mt-2 text-[15px] text-muted">cities where ChatGPT and Claude used at least one same source on {d3}. In the other {50 - src.cities_with_shared}, they read different sites.</p>
    </div>
  </div>
  <p>Top sources for each engine on all 3 dates (answers that used the domain). "Core" marks a domain in the engine's top 10 on every date.</p>
  {
    srcEngines.map((k) => (
      <>
        <p><strong>{engineName[k]}</strong> (about {se[k].per_date[d3].avg_sources} sources per answer, {se[k].per_date[d3].distinct_domains} different domains on {d3}):</p>
        <table>
          <thead><tr><th>Domain</th>{se[k].dates.map((d) => <th>{d}</th>)}</tr></thead>
          <tbody>
            {se[k].top.slice(0, 12).map((x) => <tr><td>{x.domain}{se[k].core.includes(x.domain as string) ? " (core)" : ""}</td>{se[k].dates.map((d) => <td>{x[d]}</td>)}</tr>)}
          </tbody>
        </table>
      </>
    ))
  }
  <p>
    In update 1 ({d2}), Gemini was the only engine that used Reddit: {ch.domains.find((x) => x.domain === "reddit.com")?.new ?? 0} of its 50 answers. ChatGPT and Claude
    used Reddit in 0 answers on all 3 dates.
  </p>

  <h3>Compared with the Goodjuju study</h3>
  <p>
    Goodjuju Marketing ran a similar test on 2026-10-30: 30 cities, 4 engines, one run (<a href={gjUrl}>their study and dataset</a>). Their data and ours agree on the main point:
    a short list of directories builds the answer. They found that 11 of 146 sources had 57% of all citations. The numbers below are their counts next to ours. The methods differ: they used the consumer apps,
    and their Claude column is Claude with "and cite sources" added to the prompt. Our Claude list holds every search result Claude read. So compare the order, not the size.
  </p>
  <table>
    <thead>
      <tr><th>Domain</th><th>Goodjuju ChatGPT (of 30 cities)</th><th>Our ChatGPT {d3} (of {n3("chatgpt")})</th><th>Goodjuju Claude, cite (of 30)</th><th>Our Claude {d3} (of {n3("claude")})</th></tr>
    </thead>
    <tbody>
      {
        gj.map((g) => (
          <tr>
            <td>{g.domain}</td>
            <td>{gjCell(g.chatgpt)}</td>
            <td>{w(g.domain, "chatgpt", d3)} ({share(w(g.domain, "chatgpt", d3), n3("chatgpt"))})</td>
            <td>{gjCell(g.claude)}</td>
            <td>{w(g.domain, "claude", d3)} ({share(w(g.domain, "claude", d3), n3("claude"))})</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p>Where the two data sets agree, and where not:</p>
  <ul>
    <li><strong>Agree:</strong> Expertise.com and iPropertyManagement.com are main sources for Claude in both. ChatGPT uses Bestinhood and gives few sources per answer in both (Goodjuju: about 2.3; ours: {se.chatgpt.per_date[d3].avg_sources}).</li>
    <li><strong>Not the same:</strong> Yelp is in almost every Claude answer in our data, but in 2 of 30 cities for Goodjuju. Birdeye is ChatGPT's top source for us ({w("birdeye.com", "chatgpt", d3)} of {n3("chatgpt")}) and 3 of 30 for Goodjuju. Goodjuju's Claude used PropertyManagement.com and Awning in about half the cities; ours in {w("propertymanagement.com", "claude", d3)} and {w("awning.com", "claude", d3)} of {n3("claude")}.</li>
    <li><strong>Only in Goodjuju:</strong> Google Business Profiles and Maps were their top source (61 citations), from Google AI Mode and from Claude without "cite sources". Reddit came from AI Mode (17 cities) and Perplexity (11). We did not test those engines.</li>
    <li><strong>Only in ours:</strong> change over time. Expertise.com fell in ChatGPT from {w("expertise.com", "chatgpt", date)} to {w("expertise.com", "chatgpt", d3)} answers in 4 weeks. A one-day test cannot show this.</li>
  </ul>

  <h3>Sources for each city ({d3})</h3>
  <p>The domains each engine used for each city. "Both" lists the sources that ChatGPT and Claude shared.</p>
  <table>
    <thead><tr><th>City</th><th>ChatGPT</th><th>Claude</th><th>Both</th></tr></thead>
    <tbody>
      {
        src.cities.map((c) => (
          <tr>
            <td>{c.city}, {c.state}</td>
            <td>{((c.engines as Record<string, string[]>).chatgpt ?? ["no answer"]).join(", ")}</td>
            <td>{((c.engines as Record<string, string[]>).claude ?? ["no answer"]).join(", ")}</td>
            <td>{c.shared.length ? c.shared.join(", ") : "–"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p>
    What this means for you: do not bet on one directory. In 4 weeks ChatGPT moved from Expertise.com to Birdeye and new directory sites. Be listed on the 5 to 8 sites the engines
    read for your city, and check them each month. <a href={csv3Url} download>Download the update 2 CSV</a> ({n3("chatgpt") + n3("claude")} rows, same columns).
  </p>

  <h2 id="update-1">Update 1: what changed in 14 days</h2>
  <p>
    AI engines changed many of the names in 14 days, but they kept the same sources. On {d2} we sent the same prompt to the same 3 models for the same 50 cities
    ({ch.overall.answers.new} answers received, {ch.overall.answers_failed.new} failed). The rest of this page shows the first run ({date}).
  </p>
  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-md bg-sun/30 p-5">
      <p class="text-[34px] leading-none">{Math.round(r.all.pct_kept)}%</p>
      <p class="mt-2 text-[15px] text-muted">of the names came back in the same engine's answer for the same city ({r.all.kept.toLocaleString("en-US")} of {r.all.old_names.toLocaleString("en-US")}).</p>
    </div>
    <div class="rounded-md bg-coral/25 p-5">
      <p class="text-[34px] leading-none">{r.all.same_list} of {N}</p>
      <p class="mt-2 text-[15px] text-muted">answers gave the same list of companies. In {r.all.no_name_kept} answers, no name came back.</p>
    </div>
    <div class="rounded-md bg-sky/25 p-5">
      <p class="text-[34px] leading-none">{ch.cities_top_same} of 50</p>
      <p class="mt-2 text-[15px] text-muted">cities kept the same most-named company. {ch.overall.cities_with_full_agreement.new} cities had a name that all 3 engines gave (first run: {ch.overall.cities_with_full_agreement.old}).</p>
    </div>
    <div class="rounded-md bg-mint/40 p-5">
      <p class="text-[34px] leading-none">{exp2.new} of {N}</p>
      <p class="mt-2 text-[15px] text-muted">answers used Expertise.com as a source (first run: {exp2.old}). It is still the top source.</p>
    </div>
  </div>
  <p>Names that came back, by engine (same city, same engine, {date} to {d2}):</p>
  <table>
    <thead><tr><th>Engine</th><th>Names in first run</th><th>Named again</th><th>Share kept</th><th>Same list</th></tr></thead>
    <tbody>
      {engineOrder.map((k) => <tr><td>{engineName[k]}</td><td>{r[k].old_names}</td><td>{r[k].kept}</td><td>{Math.round(r[k].pct_kept)}%</td><td>{r[k].same_list} of 50</td></tr>)}
    </tbody>
  </table>
  <p>The totals moved less than the names. All {N} answers, first run and update 1:</p>
  <table>
    <thead><tr><th>Measure</th><th>{date}</th><th>{d2}</th></tr></thead>
    <tbody>
      {changeRows.map((m) => <tr><td>{m.label}</td><td>{fmt(ch.overall[m.key].old, m.unit)}</td><td>{fmt(ch.overall[m.key].new, m.unit)}</td></tr>)}
      <tr><td>Different companies named</td><td>{ch.overall.distinct_companies.old}</td><td>{ch.overall.distinct_companies.new}</td></tr>
    </tbody>
  </table>
  <p>Top source domains on both dates (answers of {N}):</p>
  <table>
    <thead><tr><th>Domain</th><th>{date}</th><th>{d2}</th><th>Change</th></tr></thead>
    <tbody>{ch.domains.slice(0, 15).map((x) => <tr><td>{x.domain}</td><td>{x.old}</td><td>{x.new}</td><td>{sign(x.delta)}</td></tr>)}</tbody>
  </table>
  <p>National or multi-state brands on both dates (answers of {N}). A count is not a rating of any company.</p>
  <table>
    <thead><tr><th>Brand</th><th>{date}</th><th>{d2}</th></tr></thead>
    <tbody>{ch.national.slice(0, 12).map((x) => <tr><td>{x.name}</td><td>{x.old}</td><td>{x.new}</td></tr>)}</tbody>
  </table>
  <p>
    What this means for you: one AI answer is a sample, not a rank. Check your city more than once, and with each engine. Work on the sources, because they
    stay: Expertise.com, Yelp, iPropertyManagement.com, PropertyManagement.com and Birdeye were in the top sources on both dates.
    <a href={csv2Url} download>Download the update 1 CSV</a> ({ch.overall.answers.new} rows, same columns).
  </p>

  <h2 id="method">How we ran the test</h2>
  <p>We sent the same prompt to each engine on {date}, one run per city and engine:</p>
  <p><strong>"What is the best property management company in &lt;City, ST&gt;? Give names."</strong></p>
  <ul>
    <li><strong>Cities.</strong> The 50 most populous US cities, from US Census Bureau estimates for July 1, 2025 (New York, NY to Aurora, CO).</li>
    <li>
      <strong>Engines.</strong> ChatGPT ({e.chatgpt.model} with web search), Gemini ({e.gemini.model} with Google Search grounding) and Claude
      ({e.claude.model} with web search). We used each vendor's API, not the consumer apps.
    </li>
    <li><strong>Answers.</strong> {N} sent, {N - o.answers_failed} received, {o.answers_failed} failed.</li>
    <li><strong>Company names.</strong> A second model (Claude Haiku) listed the companies in each answer. We merged offices of one brand (for example franchise offices).</li>
    <li>
      <strong>National or multi-state brand.</strong> A fixed list of 39 brands that work in several states, such as Real Property Management, HomeRiver Group, Evernest,
      PMI, Keyrenter, Mynd, Ziprent and Greystar. All other names count as local firms.
    </li>
    <li>
      <strong>Sources.</strong> The domains each engine attached to its answer. For Claude, this list includes every search result that Claude read, not only the links in the text.
    </li>
  </ul>
  <p>
    Limits: AI answers change between runs, days and users. One run per city shows a pattern, not a fixed rank. The consumer apps can give other answers than the API. The
    brand list and the source types are our own choice; the CSV lets you check each row.
  </p>

  <h2 id="companies">Which companies AI names</h2>
  <p>
    AI engines name many local firms, and a few national brands in many cities. The 3 engines named {o.distinct_companies} different companies; {o.distinct_local_companies}
    of them were local firms. National or multi-state brands came up in {o.cities_with_national} of 50 cities.
  </p>
  <p>Brands that the engines named in the most answers (our data, {date}):</p>
  <table>
    <thead><tr><th>Brand</th><th>Answers (of {N})</th><th>Cities (of 50)</th></tr></thead>
    <tbody>
      {data.top_national.map((c) => <tr><td>{c.name}</td><td>{c.answers}</td><td>{c.cities}</td></tr>)}
    </tbody>
  </table>
  <p>
    Local firms rarely appear in more than one city, so each one has at most 3 answers here. The city table below shows the local firms that the engines named most.
  </p>

  <h2 id="sources">Which sources AI uses</h2>
  <p>
    Directories and review sites are the main sources for this question. Expertise.com was a source in {expertise} of {N} answers. Yelp and iPropertyManagement.com
    were each a source in {yelp} answers.
  </p>
  <figure class="not-prose my-6">
    <svg viewBox={`0 0 ${chartW} ${bars.length * rowH + 10}`} role="img" aria-labelledby="dom-t dom-d" class="w-full" style="max-width: 720px">
      <title id="dom-t">Top 15 source domains</title>
      <desc id="dom-d">Number of answers, out of {N}, that used each domain as a source.</desc>
      {
        bars.map((b, i) => {
          const w = Math.max(2, (plotW * b.answers) / barMax);
          const y = i * rowH + 4;
          return (
            <g>
              <title>{`${b.domain}: ${b.answers} of ${N} answers`}</title>
              <text x={labelW - 8} y={y + 15} text-anchor="end" font-size="13" fill="#1c1712">{b.domain}</text>
              <rect x={labelW} y={y + 3} width={w} height={rowH - 10} rx="4" fill="#c1410b" />
              <text x={labelW + w + 6} y={y + 15} font-size="13" fill="#5c5145">{b.answers}</text>
            </g>
          );
        })
      }
      <line x1={labelW} x2={labelW} y1="0" y2={bars.length * rowH + 6} stroke="#b8a88c" stroke-width="1" />
    </svg>
    <figcaption class="mt-2 text-[14px] text-muted">Answers (of {N}) that used each domain as a source. Our data, {date}.</figcaption>
  </figure>
  <p>The same sources by type. One answer can have several types.</p>
  <table>
    <thead><tr><th>Source type</th><th>Answers (of {N})</th></tr></thead>
    <tbody>{types.map(([t, n]) => <tr><td>{typeLabel[t] ?? t}</td><td>{n}</td></tr>)}</tbody>
  </table>
  <p>
    Directories and review sites that the engines used most: {data.top_listing_domains.slice(0, 10).map((d) => `${d.domain} (${d.answers})`).join(", ")}.
  </p>

  <h2 id="engines">ChatGPT vs Gemini vs Claude</h2>
  <p>
    The 3 engines answer the same question in different ways. Claude names the most companies and reads the most sources. Gemini links company sites and Reddit most.
    ChatGPT gives short lists from directories: {e.chatgpt.answers_with_listing_site} of its 50 answers used one, and {e.chatgpt.answers_with_company_site} linked a company site.
  </p>
  <table>
    <thead>
      <tr><th>Measure (50 answers each)</th>{engineOrder.map((k) => <th>{engineName[k]}</th>)}</tr>
    </thead>
    <tbody>
      {metrics.map((m) => <tr><td>{m.label}</td>{engineOrder.map((k) => <td>{fmt(e[k][m.key], m.unit)}</td>)}</tr>)}
    </tbody>
  </table>
  <p>Top sources for each engine:</p>
  <ul>
    {engineOrder.map((k) => <li><strong>{engineName[k]}.</strong> {e[k].top_domains.slice(0, 5).map((d) => `${d.domain} (${d.answers})`).join(", ")}.</li>)}
  </ul>

  <h2 id="cities">Results for each city</h2>
  <p>
    Each city has 3 answers, one per engine. The number after a name shows how many of the 3 answers named it. "Brand" marks a national or multi-state brand.
  </p>
  <table>
    <thead>
      <tr><th>#</th><th>City</th><th>Companies named most (answers of 3)</th><th>Main sources</th></tr>
    </thead>
    <tbody>
      {
        data.cities.map((c) => (
          <tr>
            <td>{c.rank}</td>
            <td>{c.city}, {c.state}</td>
            <td>{c.top_companies.map((t) => `${t.name} (${t.answers})${t.national ? " brand" : ""}`).join("; ")}</td>
            <td>{c.top_domains.slice(0, 4).join(", ")}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2 id="what-to-do">What this means for property managers</h2>
  <p>AI engines build the "best property manager" answer from a small set of sources. Be on those sources for your city.</p>
  <ol>
    <li><strong>Check your Expertise.com page.</strong> Expertise.com was a source in {expertise} of {N} answers, more than any other site. See if your city list names you, and what the list needs.</li>
    <li><strong>Get reviews on Yelp, BBB and Birdeye.</strong> Yelp was a source in {yelp} answers, Birdeye in {dom("reviews.birdeye.com")} and BBB in {dom("bbb.org")}.</li>
    <li><strong>Claim your iPropertyManagement.com and PropertyManagement.com profiles.</strong> iPropertyManagement.com was a source in {ipm} answers, most of them from Claude.</li>
    <li><strong>Find the local best-of lists.</strong> ThreeBestRated, Bestinhood, Trustanalytica and city blogs show up in the city rows above. Check the lists for your city.</li>
    <li><strong>Make your own site answer the question.</strong> Gemini linked a company site in {pct(e.gemini.answers_with_company_site, 50)}% of answers. Say the city, the property types, the fees and the reviews in plain text.</li>
    <li><strong>Help in local Reddit threads.</strong> Reddit was a source in {dom("reddit.com")} answers, all of them from Gemini. Answer owner questions with facts, not ads.</li>
  </ol>
  <p>
    Want to know if AI names your company in your city? Read <a href="/guides/how-owners-choose-a-property-manager-with-ai">how owners choose a property manager with AI</a>,
    or ask us for a free AI visibility audit on <a href="/property-management">our property management page</a>.
  </p>

