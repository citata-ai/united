---
import "../styles/global.css";
import { auditHref } from "../data/site.ts";

interface Props {
  title: string;
  description: string;
  /** Root-relative image path for og:image. */
  image?: string;
  type?: "website" | "article";
}
const { title, description, image = "/og/property-management.jpg", type = "website" } = Astro.props;
// build.format "file" makes Astro.url end in ".html"; the live URLs do not.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1");
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL(image, Astro.site);

/** One entity for AI and search: who we are, and that we are not Citate.ai. */
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://citata.ai/#org",
  name: "citata.ai",
  alternateName: "Citata",
  url: "https://citata.ai",
  logo: "https://citata.ai/icon.svg",
  email: "grow@citata.ai",
  description:
    "citata.ai is a done-for-you GEO and AEO agency. It gets property management companies named and linked in answers from ChatGPT, Gemini, Claude and Perplexity.",
  disambiguatingDescription:
    "citata.ai (with an a) is a GEO agency run by WarmDevs OÜ. It is not Citate.ai, a different AI visibility software product.",
  knowsAbout: [
    "Generative engine optimization (GEO)",
    "Answer engine optimization (AEO)",
    "AI search visibility",
    "Property management marketing",
    "Owner lead generation for property managers",
  ],
  areaServed: "US",
  legalName: "WarmDevs OÜ",
  founder: { "@type": "Person", name: "Taras Kornichuk" },
  sameAs: [
    "https://github.com/citata-ai",
    "https://medium.com/@citataai",
    "https://substack.com/@citata",
    "https://startupbase.io/@citata",
    "https://app.dealroom.co/companies/citata_ai",
    "https://ecosystem.startupestonia.ee/companies/citata_ai",
  ],
};

const nav = [
  { href: "/#how", label: "How it works" },
  { href: "/property-management", label: "Owner questions" },
  { href: "/case-studies/fridman-properties", label: "Case study" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/CalSansVF.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F5EFE3" />
    <meta property="og:site_name" content="citata.ai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="ahrefs-site-verification" content="c373191b9e5ef7a015c4cc2786b14f0c505cd415d2516dc4d70cb57db4fa2f1b" />
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="ZBFZfEWCf4yVC1R7LkUI3w" async></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <slot name="head" />
  </head>
  <body class="font-sans text-base leading-normal antialiased">
    <div class="sticky top-0 z-50 border-b border-rule bg-parchment/90 backdrop-blur supports-[backdrop-filter]:bg-parchment/80">
      <header class="wrap flex items-center justify-between gap-6 py-3">
        <a href="/" aria-label="citata.ai home">
          <img src="/wordmark.svg" alt="Citata" width="157" height="56" class="block h-12 w-auto sm:h-14" />
        </a>
        <nav aria-label="Main" class="hidden md:block">
          <ul class="flex gap-7 text-[15px] text-muted">
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} class="hover:text-ink">
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn-primary" href={auditHref}>Free AI audit</a>
      </header>
    </div>

    <slot />

    <div class="wrap">
      <footer
        class="mt-14 flex flex-col gap-6 border-t border-rule pt-8 pb-14 text-[13px] text-muted sm:flex-row sm:justify-between"
      >
        <p>
          <span class="text-ink"><em class="not-italic text-minium">Aetas aurea redit</em></span> — the
          golden age returns.<br />© {new Date().getFullYear()} citata.ai. Images made with AI.
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="hover:text-ink">
                  {n.label}
                </a>
              </li>
            ))
          }
          <li><a href="mailto:grow@citata.ai" class="hover:text-ink">grow@citata.ai</a></li>
        </ul>
      </footer>
    </div>
  </body>
</html>
