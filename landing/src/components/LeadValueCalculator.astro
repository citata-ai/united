---
// Owner lead value calculator: a small vanilla island, same pattern as RentSellCalculator.astro.
// The math lives in src/lib/calculators.ts (tested). The build renders the first result, so the
// page shows full numbers without JavaScript; the script only updates them. No data leaves the page.
import { computeLeadValue, leadValueExample as ex, usd } from "../lib/calculators.ts";

const r = computeLeadValue(ex);
const field =
  "mt-1 block h-10 w-full rounded border border-rule-strong bg-parchment px-3 text-[15px] outline-none focus:border-minium";
const fields = [
  { name: "doors", label: "Doors you manage today", step: "1" },
  { name: "rent", label: "Average monthly rent per door ($)", step: "any" },
  { name: "managementPercent", label: "Management fee (% of rent)", step: "any" },
  { name: "otherRevenuePerDoor", label: "Other fees per door per year ($: leasing, renewal)", step: "any" },
  { name: "doorsPerOwner", label: "Average doors per owner client", step: "any" },
  { name: "churnPercent", label: "Doors lost per year (% churn)", step: "any" },
  { name: "marginPercent", label: "Gross margin (% of revenue you keep)", step: "any" },
  { name: "closePercent", label: "Owner leads that sign (% close rate)", step: "any" },
  { name: "targetRatio", label: "Target ratio: lifetime profit per $1 spent", step: "any" },
] as const;
---

<form class="lv-calc rounded-md border border-rule bg-page p-5 sm:p-6" novalidate>
  <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
    {
      fields.map((f) => (
        <label>
          <span class="meta">{f.label}</span>
          <input name={f.name} type="number" inputmode="decimal" step={f.step} value={ex[f.name]} class={field} />
        </label>
      ))
    }
  </div>

  <div class="mt-6" aria-live="polite">
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="rounded-md bg-sun/35 p-4">
        <p class="meta text-ink">Max cost per lead</p>
        <p class="mt-1 text-[30px] leading-tight font-semibold" data-out="maxCostPerLead">{usd(r.maxCostPerLead)}</p>
        <p class="text-[13px] text-muted">at your target ratio</p>
      </div>
      <div class="rounded-md bg-sky/30 p-4">
        <p class="meta text-ink">Max cost per new owner</p>
        <p class="mt-1 text-[30px] leading-tight font-semibold" data-out="maxCostPerOwner">{usd(r.maxCostPerOwner)}</p>
        <p class="text-[13px] text-muted">all sales and marketing cost</p>
      </div>
      <div class="rounded-md bg-mint/40 p-4">
        <p class="meta text-ink">Leads to replace churn</p>
        <p class="mt-1 text-[30px] leading-tight font-semibold" data-out="leadsToReplaceChurn">{r.leadsToReplaceChurn}</p>
        <p class="text-[13px] text-muted">owner leads a month, zero growth</p>
      </div>
    </div>

    <table class="mt-5 w-full border-collapse text-[15px]">
      <caption class="meta pb-2 text-left">One owner client: the parts</caption>
      <tbody>
        <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 text-left font-normal">Revenue per door per year</th><td class="py-2 text-right tabular-nums" data-out="revenuePerDoorYear">{usd(r.revenuePerDoorYear)}</td></tr>
        <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 text-left font-normal">Years an owner stays (1 ÷ churn)</th><td class="py-2 text-right tabular-nums" data-out="lifetimeYears">{r.lifetimeYears}</td></tr>
        <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 text-left font-normal">Lifetime revenue per owner</th><td class="py-2 text-right tabular-nums" data-out="lifetimeRevenue">{usd(r.lifetimeRevenue)}</td></tr>
        <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 text-left font-medium">Lifetime gross profit per owner</th><td class="py-2 text-right font-medium tabular-nums" data-out="lifetimeProfit">{usd(r.lifetimeProfit)}</td></tr>
        <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 text-left font-normal">Break-even cost per lead (1:1)</th><td class="py-2 text-right tabular-nums" data-out="breakEvenCostPerLead">{usd(r.breakEvenCostPerLead)}</td></tr>
        <tr><th scope="row" class="py-2 pr-4 text-left font-normal">Doors lost per year</th><td class="py-2 text-right tabular-nums" data-out="doorsLostPerYear">{r.doorsLostPerYear}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-[12px] text-muted">
    Owner lifetime is capped at 20 years. Your numbers stay in your browser.
  </p>
</form>

<script>
  import { computeLeadValue, usd, type LeadValueInput } from "../lib/calculators.ts";

  for (const form of document.querySelectorAll<HTMLFormElement>(".lv-calc")) {
    const num = (name: string): number => {
      const el = form.elements.namedItem(name);
      return el instanceof HTMLInputElement && el.value !== "" ? Number(el.value) : 0;
    };
    const set = (key: string, text: string) => {
      for (const el of form.querySelectorAll(`[data-out="${key}"]`)) el.textContent = text;
    };
    const update = () => {
      const input: LeadValueInput = {
        doors: num("doors"),
        rent: num("rent"),
        managementPercent: num("managementPercent"),
        otherRevenuePerDoor: num("otherRevenuePerDoor"),
        doorsPerOwner: num("doorsPerOwner"),
        churnPercent: num("churnPercent"),
        marginPercent: num("marginPercent"),
        closePercent: num("closePercent"),
        targetRatio: num("targetRatio"),
      };
      const r = computeLeadValue(input);
      for (const k of [
        "maxCostPerLead",
        "maxCostPerOwner",
        "revenuePerDoorYear",
        "lifetimeRevenue",
        "lifetimeProfit",
        "breakEvenCostPerLead",
      ] as const) {
        set(k, usd(r[k]));
      }
      for (const k of ["leadsToReplaceChurn", "lifetimeYears", "doorsLostPerYear"] as const) {
        set(k, String(r[k]));
      }
    };
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    form.addEventListener("submit", (e) => e.preventDefault());
    update();
  }
</script>
